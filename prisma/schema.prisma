generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  role      String   @default("customer") // "admin" or "customer"
  isActive  Boolean  @default(true)
  
  // Relations
  sites     Site[]   // Sites owned by this user (for customers)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id           String   @id @default(cuid())
  userId       String?  // Owner of the site (customer)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  subdomain    String?  @unique
  customDomain String?  @unique
  logo         String?
  favicon      String?
  
  // Theme Settings
  brandColor   String   @default("#3b82f6")
  fontFamily   String   @default("Inter")
  
  // Hero Section / Carousel Banners
  heroTitle    String?
  heroSubtitle String?
  heroImage    String?
  heroCTA      String?  @default("Get Started")
  heroCTALink  String?
  banners      Banner[] // Multiple carousel banners
  
  // About Section
  aboutTitle   String?  @default("About Us")
  aboutContent String?
  aboutImage   String?
  
  // Services Section
  servicesTitle String? @default("Our Services")
  services      Service[]
  
  // Featured Products Section
  productsTitle       String?  @default("Featured Products")
  showProducts        Boolean  @default(false)
  products            Product[]
  
  // Gallery
  galleryTitle  String? @default("Gallery")
  galleryImages String[] // Array of image URLs
  
  // Testimonials
  testimonialsTitle String? @default("What Our Clients Say")
  testimonials      Testimonial[]
  
  // Business Hours
  showBusinessHours Boolean       @default(false)
  businessHours     BusinessHour[]
  
  // Contact Section
  contactTitle   String? @default("Get In Touch")
  contactEmail   String?
  contactPhone   String?
  contactAddress String?
  
  // Location/Stores
  showLocations Boolean   @default(false)
  locations     Location[]
  
  // Parking & Payment Info
  parkingInfo    String?
  paymentMethods String[] // Array of payment methods
  
  // Categories & Tags
  categories String[] // Array of category names
  tags       Tag[]
  
  // Social Media (Footer)
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  linkedinUrl  String?
  youtubeUrl   String?
  whatsappUrl  String?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // SEO Enhancements
  businessType        String   @default("LocalBusiness") // "LocalBusiness", "Bakery", "AutoDealer", "Restaurant"
  industryCategory    String?  // Specific industry categorization
  primaryKeywords     String[] // ["bakery near me", "custom wedding cakes"]
  secondaryKeywords   String[] // ["gluten-free bakery", "birthday cake delivery"]
  localModifiers      String[] // ["San Francisco", "Austin", "Downtown"]
  
  // Aggregate Rating (auto-calculated from testimonials)
  aggregateRating     Float?   // Average rating
  totalReviews        Int      @default(0)
  
  // Analytics Integration
  googleAnalyticsId   String?  // GA4 Measurement ID
  googleTagManagerId  String?  // GTM Container ID
  facebookPixelId     String?  // Facebook Pixel ID
  
  // Search Console Verification
  googleSiteVerification String?
  bingWebmasterVerification String?
  
  // Visibility Toggles
  showHero         Boolean @default(true)
  showBanners      Boolean @default(false)
  showAbout        Boolean @default(true)
  showServices     Boolean @default(true)
  showGallery      Boolean @default(false)
  showTestimonials Boolean @default(false)
  showContact      Boolean @default(true)
  showFAQ          Boolean @default(false)

  // Notification Banner
  notificationEnabled  Boolean @default(false)
  notificationMessage  String?
  notificationPosition String  @default("top") // "top" or "bottom"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  navLinks NavLink[]
  leads    Lead[]
  faqs     FAQ[]
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  message   String?
  status    String   @default("NEW") // NEW, CONTACTED, CLOSED
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String  @id @default(cuid())
  title       String?
  subtitle    String?
  image       String  // Banner image URL
  ctaText     String?
  ctaLink     String?
  order       Int     @default(0)
  isActive    Boolean @default(true)
  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  
  createdAt DateTime @default(now())
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  image       String?
  price       String? // Display price (e.g., "Starting at ₹11,99,000")
  ctaText     String  @default("View Details")
  ctaLink     String?
  features    String[] // Array of feature strings
  order       Int     @default(0)
  isActive    Boolean @default(true)
  
  // SEO Fields
  slug            String? // URL-friendly slug (e.g., "2024-tesla-model-3")
  keywords        String[] // Product-specific keywords
  metaTitle       String?
  metaDescription String?
  imageAlt        String? // Alt text for main image
  
  // Vehicle-Specific Fields (for Auto Dealers)
  vehicleType String? // "Car", "Truck", "SUV", "Motorcycle"
  make        String? // "Tesla", "BMW", "Toyota"
  model       String? // "Model 3", "3 Series", "Camry"
  year        Int?    // 2024
  mileage     Int?    // Odometer reading
  vin         String? // Vehicle Identification Number
  fuelType    String? // "Electric", "Gasoline", "Diesel", "Hybrid"
  condition   String? // "New", "Used", "Certified Pre-Owned"
  transmission String? // "Automatic", "Manual"
  exteriorColor String?
  interiorColor String?
  
  // Bakery Product-Specific Fields
  ingredients  String[] // ["flour", "sugar", "eggs", "butter"]
  allergens    String[] // ["gluten", "dairy", "nuts", "eggs"]
  servingSize  String?  // "Serves 8-10", "12 cupcakes"
  dietaryInfo  String[] // ["vegan", "gluten-free", "sugar-free", "organic"]
  
  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([siteId, slug])
}

model BusinessHour {
  id        String @id @default(cuid())
  day       String // "Monday", "Tuesday", etc.
  openTime  String // "10:00 AM"
  closeTime String // "08:00 PM"
  isClosed  Boolean @default(false)
  order     Int    @default(0)
  site      Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  
  createdAt DateTime @default(now())
}

model Location {
  id          String  @id @default(cuid())
  name        String  // "Samsung SmartPlaza in Haryana"
  city        String?
  state       String?
  address     String?
  mapLink     String?
  order       Int     @default(0)
  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  
  createdAt DateTime @default(now())
}

model Tag {
  id     String @id @default(cuid())
  name   String // "Galaxy S25", "Galaxy S25 Ultra", etc.
  link   String? // Optional link for the tag
  order  Int    @default(0)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String
  
  createdAt DateTime @default(now())
}

model Service {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String? // Icon name or emoji
  site        Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  order       Int    @default(0)
  
  createdAt DateTime @default(now())
}

model Testimonial {
  id      String  @id @default(cuid())
  name    String
  role    String?
  content String
  avatar  String?
  rating  Int     @default(5)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId  String
  order   Int     @default(0)
  
  createdAt DateTime @default(now())
}

model NavLink {
  id         String  @id @default(cuid())
  label      String
  href       String
  order      Int     @default(0)
  isExternal Boolean @default(false)
  site       Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId     String
  
  createdAt DateTime @default(now())
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text // Use Text for longer answers
  order    Int    @default(0)
  isActive Boolean @default(true)
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId   String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}